/san-pham/*
  Cache-Control: public, max-age=0, must-revalidate

/chinh-sach-bao-mat/*
  Cache-Control: public, max-age=0, must-revalidate

/dieu-khoan-su-dung/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/css/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/config.js
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/data.js
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/components.js
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/app.js
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/form-submit-final.js
  Cache-Control: public, max-age=0, must-revalidate
